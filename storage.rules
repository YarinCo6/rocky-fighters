rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Fight videos live under the uploader's own uid. Only the owner can write or
    // delete. Playback for coaches goes through the download URL stored on the
    // athlete's Firestore doc, which Firestore rules already restrict to staff.
    match /videos/{userId}/{videoId}/{fileName} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.size <= 500 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if isOwner(userId);
      allow update: if false;
    }

    // Personal documents (medical clearance, passport, insurance...). Same model:
    // owner-only object access, staff view through the stored download URL.
    match /documents/{userId}/{docId}/{fileName} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/jpeg|image/png)');
      allow delete: if isOwner(userId);
      allow update: if false;
    }

    // Everything else in the bucket is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

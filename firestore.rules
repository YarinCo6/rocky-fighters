rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin is identified ONLY by a hardcoded email from the auth token.
    // It can never be granted from the client, so it can't be self-assigned.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'yarin5cohen@gmail.com';
    }

    function isCoach() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
    }

    match /users/{userId} {
      // Admin: full read/write on everyone.
      allow read, write: if isAdmin();

      // Coach: read all competitor docs.
      allow read: if isCoach();

      // Coach: may write ONLY the coachFeedback field on a competitor doc.
      // Cannot touch role, profile, or any other field.
      allow update: if isCoach()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coachFeedback']);

      // Owner: read own doc.
      allow read: if request.auth != null && request.auth.uid == userId;

      // Owner create: only own doc, and role is forced to 'competitor'.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'competitor';

      // Owner update: own doc, but role can NOT be changed (only admin can).
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
    }
  }
}
